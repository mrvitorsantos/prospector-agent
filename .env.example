# === Fonte de dados (coleta dos leads) ===

# "overpass" (padrão, grátis) usa OpenStreetMap. "google_places" tem
# cobertura de telefone bem melhor mas é faturado após a cota gratuita
# mensal (ver README, seção "Fonte de dados", e docs/PRD.md seção 7) — só
# mude pra "google_places" depois de configurar GOOGLE_PLACES_API_KEY abaixo.
LEAD_SOURCE=overpass

# Chave da Google Places API (New) — só necessária se LEAD_SOURCE=google_places.
# Gere em https://console.cloud.google.com/google/maps-apis/credentials
# (exige billing habilitado no projeto do Google Cloud, mesmo pra usar só a
# cota gratuita mensal) e habilite a "Places API (New)".
GOOGLE_PLACES_API_KEY=

# === Gemini API (qualificação dos leads) ===

# Chave da API do Gemini — gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nome do modelo Gemini usado para gerar score + mensagem de abordagem.
# Use o alias "-latest" (ex: gemini-flash-latest) em vez de uma versão pinada
# (ex: gemini-2.0-flash): versões pinadas são aposentadas periodicamente e
# passam a responder 404 "no longer available to new users" sem aviso prévio.
# Nomes válidos: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest

# Timeout (ms) para cada chamada à Gemini API. Se estourar ou a API falhar,
# qualify.js usa uma heurística de fallback (ver src/lib/gemini.js) para não
# travar o pipeline.
GEMINI_TIMEOUT_MS=30000

# Quantos leads vão em cada chamada à Gemini API (qualify.js agrupa leads em
# lotes pra economizar quota de requests). Lote maior = menos requests, mas
# prompt/resposta maiores — ajuste se estourar token limit ou timeout.
GEMINI_BATCH_SIZE=10

# === Banco de dados ===

# Caminho do arquivo SQLite, relativo à raiz do projeto.
DB_PATH=data/leads.db

# === WhatsApp ===

# DDI usado para montar o link wa.me quando o telefone coletado no OSM não
# tem código de país (Brasil = 55).
WA_DEFAULT_COUNTRY_CODE=55
