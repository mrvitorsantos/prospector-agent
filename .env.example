# === Gemini API (qualificação dos leads) ===

# Chave da API do Gemini — gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nome do modelo Gemini usado para gerar score + mensagem de abordagem.
# ATENÇÃO: nomes de modelo do Gemini mudam com frequência (ex: gemini-1.5-flash,
# gemini-2.0-flash, gemini-2.5-flash, etc). O valor abaixo pode estar desatualizado
# — confira o nome vigente ANTES de rodar em:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# Timeout (ms) para cada chamada à Gemini API. Se estourar ou a API falhar,
# qualify.js usa uma heurística de fallback (ver src/lib/gemini.js) para não
# travar o pipeline.
GEMINI_TIMEOUT_MS=30000

# === Banco de dados ===

# Caminho do arquivo SQLite, relativo à raiz do projeto.
DB_PATH=data/leads.db

# === WhatsApp ===

# DDI usado para montar o link wa.me quando o telefone coletado no OSM não
# tem código de país (Brasil = 55).
WA_DEFAULT_COUNTRY_CODE=55
